{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header"><b>휴대폰 인증 (도전과제)</b></div>
        <div class="card-body">
            <!-- 원래 자원의 요청은 GET 요청이 일반적이다. 하지만 로그인 요청은 예외적으로
            사용자의 이름과 비밀번호를 작성해야 되기 때문에 보안상 이유로 반드시 POST 요청을 해야한다.-->
            <form action="/user/number" method="post">

                <div class="mb-3">
                    <input type="text" class="form-control" id="num" placeholder="하이픈 없이 입력">
                    <button type="button" class="btn btn-outline-secondary mt-2" id="send-btn" onclick="sendCode()">인증번호 전송</button>
                </div>

                {{! 인증번호 입력 (처음엔 숨김, 발송 후 보임) }}
                <div class="mb-3" id="code-box" style="display: none;">
                    <div class="input-group">
                        <input type="text" class="form-control" id="code" placeholder="인증번호 6자리">
                        <button type="button" class="btn btn-outline-secondary" onclick="verifyCode()">확인</button>
                    </div>
                    <div id="msg" class="form-text"></div>
                </div>
                <a href="/user/detail" class="btn btn-secondary">마이페이지로 돌아가기</a>
            </form>
        </div>
    </div>
</div>

<script>
    // 인증 완료 여부 (화면 안내용, 실제 검사는 서버의 세션으로 함)
    let isSmsVerified = false;
    // 1. 인증번호 전송
    async function sendCode() {
        const num = document.querySelector("#num").value; // 사용자 입력: a@naver.com
        if (!num) {
            alert("전화번호를 입력해주세요");
            return;
        }

        // 메일 발송은 몇 초 걸리므로, 그동안 버튼을 막아 중복 요청을 방지한다. (중요!!)
        const sendBtn = document.querySelector("#send-btn");
        sendBtn.disabled = true;
        sendBtn.innerText = "전송 중...";

        try {
            const response = await fetch("/api/num/send", {
                method: "POST",
                headers: {"Content-Type" : "application/json"}, // 바디가 JSON이라고 알림
                body: JSON.stringify({num: num}) // 객체 --> JSON 문자열로 변환됨 (JSON.stringify)
            });

            const result = await response.json(); // JSON 응답 --> 자바스크립 객체로 변환됨
            // 백엔드 개발자와 어떤 식으로 요청을 보내고 어떤 식으로 응답이 올지 확인 해야 한다.
            // 백엔드 API에서 key : message로 내려 보내기로 했다.
            alert(result.message);
            if (response.ok) {
                document.querySelector("#code-box").style.display = "block";
            }

        } catch (e) {
            alert("서버와 통신하지 못했습니다.")
        } finally {
            sendBtn.disabled = false;
            sendBtn.innerText = "인증번호 전송"
        }
    }

    // 2. 인증번호 확인 전송
    async function verifyCode() {
        // 사용자 전화번호, 인증 코드 (6자리)
        const num = document.querySelector("#num").value;
        const code = document.querySelector("#code").value;

        if (!code) {
            alert("인증번호를 입력해주세요");
            return;
        }

        try {
            const response = await fetch("/api/num/verify", {
                method: "POST",
                headers: {"Content-Type" : "application/json"},
                body: JSON.stringify({num: num, code: code}) // 객체 --> JSON으로 변환
            });
            const result = await response.json(); // JSON --> 객체로 변환
            const msgBox = document.querySelector("#msg");
            if (response.ok) {
                isSmsVerified = true;
                msgBox.innerText = result.message; // "인증되었습니다."
                msgBox.className = "form-text text-success";
                // 인증한 전화번호를 화면단에서 바꾸지 못하게 잠금 설정
                document.querySelector("#num").readOnly = true;
                document.querySelector("#send-btn").disabled = true;
            } else {
                msgBox.innerText = result.message;
                msgBox.className = "form-text text-danger";
            }
        } catch (e) {
            console.log(e);
            alert("서버와 통신하지 못했습니다.");
        }
    }

    // 3. 회원가입 제출 직전 확인 (false를 반환하면 제출이 취소 됨)
    function checkVerify() {
        if (!isSmsVerified) {
            alert("이메일 인증을 먼저 완료해주세요");
            return false;
        }
        return true;
    }

</script>


{{> layout/footer}}
