{{> layout/header}}

<div class="container p-5">

    <!-- 게시글 제목 -->
    <div class="d-flex justify-content-between align-items-center">

        <h2>
            <b>{{board.title}}</b>
        </h2>

        <!-- 수정 / 삭제 버튼 -->
        <div class="d-flex">
            <a href="/board/{{board.id}}/update"
               class="btn btn-warning me-1">
                수정
            </a>

            <form action="/board/{{board.id}}/delete"
                  method="post"
                  id="deleteForm">

                <input type="hidden"
                       id="boardId"
                       value="{{board.id}}">

                <button type="submit"
                        class="btn btn-danger">
                    삭제
                </button>

            </form>
        </div>

    </div>

    <!-- 작성자 / 조회수 -->
    <div class="d-flex justify-content-between mt-2 mb-3">
        <div>
            <b>작성자</b> : {{board.user.username}}
        </div>

        <div>
            조회수 : {{board.viewCount}}
        </div>
    </div>

    <hr>

    <!-- 게시글 내용 -->
    <div class="m-4 p-2">
        {{board.content}}
    </div>


    <!-- 댓글 -->
    <div class="card mt-3">

        <div class="card-body">

            <form action="/reply/save" method="post">

                <textarea
                        class="form-control"
                        rows="2"
                        name="comment"
                        placeholder="댓글을 입력하세요"></textarea>

                <div class="d-flex justify-content-end">
                    <button type="submit"
                            class="btn btn-outline-primary mt-1">
                        댓글 등록
                    </button>
                </div>

            </form>

        </div>

        <div class="card-footer">
            <b>댓글 목록</b>
        </div>

        <div class="list-group">

            <!-- 댓글 1 -->
            <div class="list-group-item d-flex justify-content-between align-items-center">

                <div class="d-flex">
                    <div class="px-1 me-1 bg-primary text-white rounded">
                        박지훈
                    </div>

                    <div>
                        댓글 내용입니다
                    </div>
                </div>

                <form action="/reply/1/delete" method="post">
                    <button class="btn">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </form>

            </div>

            <!-- 댓글 2 -->
            <div class="list-group-item d-flex justify-content-between align-items-center">

                <div class="d-flex">
                    <div class="px-1 me-1 bg-primary text-white rounded">
                        이서연
                    </div>

                    <div>
                        댓글 내용입니다
                    </div>
                </div>

                <form action="/reply/2/delete" method="post">
                    <button class="btn">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </form>

            </div>

        </div>
    </div>

</div>

{{> layout/footer}}